FROM ubuntu:24.04

# Prevent interactive prompts + optimize Python behavior
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# System dependencies and Python tooling
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    python3-distutils \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install CI tooling
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel pylint coverage pytest click

# Install Rust toolchain 1.70.0
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.70.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Install project dependencies with the same extra index used by CI
RUN python3 -m pip install --no-cache-dir -r requirements.txt -r requirements-test.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu

# Run tests by default to reproduce CI until pytest
CMD ["python3", "-m", "pytest", "tests/", "-q"]