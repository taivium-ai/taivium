# Taivium Runtime Environment Variables

# Logging configuration for evaluation and audit
# LOG_LEVEL: Root logger level (DEBUG, INFO, WARNING, ERROR, CRITICAL). Default: WARNING
LOG_LEVEL=WARNING

# TAIVIUM_AUDIT_LOG_LEVEL: Audit logger level (DEBUG, INFO, WARNING, ERROR, CRITICAL). 
# If not set, defaults to LOG_LEVEL. Set to CRITICAL to suppress audit events.
TAIVIUM_AUDIT_LOG_LEVEL=WARNING

# TAIVIUM_AUDIT_STDOUT: Set to 0 to disable audit JSON emission to stdout.
# Allowed values: 0, false, off, no
TAIVIUM_AUDIT_STDOUT=1
